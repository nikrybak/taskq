# Required
TASKQ_DATABASE_URL=postgres://taskq:taskq@localhost:5432/taskq?sslmode=disable

# HTTP
TASKQ_HTTP_ADDR=:8080

# Apply embedded migrations on start (otherwise run `taskq migrate`)
TASKQ_AUTO_MIGRATE=true

# Workers
TASKQ_WORKER_ID=
TASKQ_CONCURRENCY=8
TASKQ_POLL_INTERVAL=1s
TASKQ_LEASE=30s
TASKQ_HEARTBEAT_INTERVAL=10s
TASKQ_REAP_INTERVAL=15s
TASKQ_SHUTDOWN_TIMEOUT=30s

# Retry backoff
TASKQ_BACKOFF_BASE=2s
TASKQ_BACKOFF_MAX=10m

# Recurring jobs (JSON file, see schedules.example.json)
TASKQ_SCHEDULES_FILE=

# Logging: debug | info | warn | error, json | text
TASKQ_LOG_LEVEL=info
TASKQ_LOG_FORMAT=json

# Integration tests only
TEST_DATABASE_URL=postgres://taskq:taskq@localhost:5432/taskq_test?sslmode=disable
